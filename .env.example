# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: comma-separated Gemini keys from separate Google Cloud projects.
# Extra keys from the same project share its quota and do not increase limits.
GEMINI_FALLBACK_API_KEYS=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional independent provider used when all configured Gemini providers fail.
# Create this key in the OpenAI API platform and store it as a server secret.
OPENAI_API_KEY=""
OPENAI_FALLBACK_MODEL="gpt-5-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase project used by the AI Studio app.
VITE_SUPABASE_URL="https://jymjumdypgunipgjkjak.supabase.co"
# Use the project's publishable key (or legacy anon key). Safe for client use.
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Server-only key. Never add a VITE_ prefix or expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SECRET_KEY"
